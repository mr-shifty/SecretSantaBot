[Unit]
Description=Secret Santa Bot (docker compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/parallels/projects/SecretSantaBot
EnvironmentFile=/home/parallels/projects/SecretSantaBot/.env.production
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file /home/parallels/projects/SecretSantaBot/.env.production up -d --build
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file /home/parallels/projects/SecretSantaBot/.env.production down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
