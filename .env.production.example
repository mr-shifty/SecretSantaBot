# Copy to .env.production and fill values

# Public domain for admin panel (must point to server IP / A record)
DOMAIN=your.domain.tld

# Bot config
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789
BOT_INTERNAL_SECRET=super-secret-internal-token

# Admin panel password (used by admin UI cookie auth)
ADMIN_PASSWORD=strong_admin_password_here

# PostgreSQL (optional): if you want to use Postgres instead of SQLite
# These are used to construct `DATABASE_URL` below if you prefer
POSTGRES_USER=secret
POSTGRES_PASSWORD=secret
POSTGRES_DB=secret_santa

# Example DATABASE_URL using asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://secret:secret@postgres:5432/secret_santa

# Database and other options are left as defaults (SQLite)
